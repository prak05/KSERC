# KSERC Truing-Up Engine — copy to .env
# There are no API keys here. Locally nothing leaves your machine; on AWS every
# service is reached through the ECS task's IAM role.

# local = SQLite + local folders   |   aws = DynamoDB + S3 + Textract + Bedrock
CLOUD=local

# Language model: local (Ollama / LM Studio / llama.cpp) | bedrock | offline
LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:14b

# Used when LLM_PROVIDER=bedrock (your AWS profile supplies credentials locally)
AWS_REGION=ap-south-1
LLM_MODEL=anthropic.claude-opus-5-5
LLM_FALLBACK_MODEL=anthropic.claude-opus-4-8
LLM_EFFORT=high

# Paths (defaults shown)
# DOCUMENTS_DIR=./documents
# LOCAL_DB_PATH=./data/store.sqlite3
